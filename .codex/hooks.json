{
  "description": "Attach Codex sessions opened in this project to Lark Bridge.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-hook.mjs\" start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-hook.mjs\" end",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [{
      "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-delivery-hook.mjs\" start", "timeout": 10 }]
    }],
    "PostToolUse": [{
      "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-delivery-hook.mjs\" after-tool", "timeout": 45 }]
    }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-delivery-hook.mjs\" stop", "timeout": 45 }]
    }]
  }
}
