{
  "description": "Attach Codex sessions opened in this project to Lark Bridge.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-hook.mjs\" start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-hook.mjs\" end",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-delivery-hook.mjs\"", "timeout": 5 }
      ] }
    ],
    "PostToolUse": [
      { "hooks": [
        { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-delivery-hook.mjs\"", "timeout": 30, "additionalContextLimit": 0 }
      ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-delivery-hook.mjs\"", "timeout": 30 }
      ] }
    ],
    "Interrupt": [
      { "hooks": [
        { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-delivery-hook.mjs\"", "timeout": 3 }
      ] }
    ]
  }
}
